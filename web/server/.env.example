# Port sur lequel tourne l'API
PORT=3001

# URL de connexion PostgreSQL
# Format : postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://opus:CHANGE_ME@localhost:5432/opus

# Origine autorisée pour le CORS (URL du client web)
# Exemple local : http://192.168.1.100
# Exemple prod  : https://opus.mondomaine.fr
CORS_ORIGIN=http://localhost
